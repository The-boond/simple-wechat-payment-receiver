{
  "bridge": {
    "url": "https://YOUR_DOMAIN.example/api/payment/event",
    "token_env": "WECHAT_RECEIVER_TOKEN",
    "timeout_seconds": 10,
    "user_agent": "Simple-WeChat-Payment-Receiver/1.2"
  },
  "agent": {
    "id": "linux-collector-01"
  },
  "channel": {
    "id": "7821",
    "provider": "wxpay"
  },
  "runtime": {
    "poll_seconds": 0.5,
    "spool_dir": "spool/linux",
    "dedupe_file": "spool/linux/receipt-dedupe.json",
    "capture_trigger_file": "spool/linux/capture-trigger.json",
    "max_retry_seconds": 300,
    "no_candidate_max_age_seconds": 2100,
    "retry_max_age_seconds": 86400
  },
  "parser": {
    "timezone": "Asia/Shanghai",
    "max_event_age_seconds": 180,
    "recovery_max_event_age_seconds": 600,
    "max_future_seconds": 60,
    "include_raw_ocr_text": false,
    "receipt_pattern": "(?:经营码)?收款到账通知.{0,200}?(?P<month>\\d{1,2})月(?P<day>\\d{1,2})日(?P<hour>\\d{1,2}):(?P<minute>\\d{2}).{0,300}?(?:收款金额)?[￥¥YV]?(?P<amount>[0-9Oo]+[.．。][0-9Oo]{1,2})"
  },
  "linux": {
    "trigger_quiet_seconds": 0.8,
    "render_delay_seconds": 2,
    "max_debounce_seconds": 5,
    "capture_retry_seconds": 15,
    "startup_recovery_enabled": true,
    "screen_probe_interval_seconds": 15,
    "screen_probe_hamming_threshold": 3,
    "trigger_files": [
      "/home/YOUR_USER/xwechat_files/*/db_storage/message/biz_message_0.db-wal"
    ],
    "display": ":88",
    "window_name_regexes": [
      "^微信支付商家助手$",
      "^微信收款助手$"
    ],
    "window_probe": "xdotool",
    "capture_tool": "import",
    "convert_tool": "convert",
    "ocr_tool": "tesseract",
    "ocr_language": "chi_sim+eng",
    "ocr_psm": 6,
    "ocr_workers": 1,
    "capture_timeout_seconds": 15,
    "ocr_timeout_seconds": 30,
    "probe_timeout_seconds": 15,
    "window_width": 720,
    "window_height": 860,
    "window_x": 0,
    "window_y": 0,
    "scroll_down_clicks": 40,
    "adaptive_scroll_enabled": true,
    "adaptive_scroll_clicks": 4,
    "adaptive_scroll_max_frames": 6,
    "clock_probe_thresholds": [82, 76, 88],
    "capture_dir": "captures/linux",
    "keep_screenshots": false,
    "screenshot_retention_days": 7,
    "screenshot_max_files": 2000,
    "capture_attempts": [
      {"delay_seconds": 2, "scroll_up_clicks": 0},
      {"delay_seconds": 5, "scroll_up_clicks": 2},
      {"delay_seconds": 9, "scroll_up_clicks": 4}
    ]
  }
}
